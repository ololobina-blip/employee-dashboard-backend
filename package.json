{
  "name": "employee-dashboard-database",
  "version": "1.0.0",
  "description": "Employee dashboard backend: Google Sheets sync + read API for frontend",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engineStrict": true,
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "sync": "tsx src/sync-sheets.ts",
    "db:init": "tsx src/init-db.ts",
    "db:migrate": "tsx src/migrate-v2.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "axios": "^1.13.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.4",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
